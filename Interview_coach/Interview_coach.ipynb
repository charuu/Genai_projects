    "# PART 3 - Pydantic schema for structured scoring\n",
    "# NOTE: We cover Pydantic (BaseModel, Field, validation) properly in Class 16\n",
    "# (Structured Outputs and Pydantic). This is a preview - full setup and exercises\n",
    "# are in that class. For now, read this as a schema definition: each field is a\n",
    "# typed slot with constraints and a description the model reads when generating JSON.\n",
    "\n",
    "class AnswerScore(BaseModel):\n",
    "    reasoning: str = Field(\n",
    "        description=\"Step-by-step analysis of the answer before assigning scores. Think through what the answer got right, what it missed, and why.\"\n",
    "    )\n",
    "    clarity: int = Field(\n",
    "        ge=1, le=5,\n",
    "        description=\"How clearly was the answer communicated? 1=incoherent, 5=perfectly structured\"\n",
    "    )\n",
    "    correctness: int = Field(\n",
    "        ge=1, le=5,\n",
    "        description=\"How accurate was the answer? 1=fundamentally wrong, 5=completely correct\"\n",
    "    )\n",
    "    completeness: int = Field(\n",
    "        ge=1, le=5,\n",
    "        description=\"How complete was the answer? 1=major gaps, 5=covered everything important\"\n",
    "    )\n",
    "    feedback: str = Field(\n",
    "        description=\"2-3 sentences of specific, actionable feedback. Do not give away the correct answer. Point to gaps.\"\n",
    "    )\n",
    "    pass_threshold: bool = Field(\n",
    "        description=\"True if the overall answer meets a passing bar (average score >= 3). False otherwise.\"\n",
    "    )\n",
    "\n",
    "# Inspect the JSON schema that will be sent to the API\n",
    "schema = AnswerScore.model_json_schema()\n",
    "print(json.dumps(schema, indent=2))"
   ]
