    "# PART 4 - Tool definition and Tool Arbiter\n",
    "# NOTE: The Tool Arbiter concept was introduced in Class 10 (Function Calling) - the\n",
    "# concept reference below is correct. However, the Python implementation here\n",
    "# (json.loads, dict routing, model_dump_json) uses Python foundations from Module 2.\n",
    "# We cover Python data structures and JSON handling in Class 14. This is a preview -\n",
    "# full implementation exercises are in Class 17 (Function Calling in Python).\n",
    "\n",
    "# Build the tool definition from the Pydantic schema\n",
    "def build_tool_definition():\n",
    "    schema = AnswerScore.model_json_schema()\n",
    "    return {\n",
    "        \"type\": \"function\",\n",
    "        \"function\": {\n",
    "            \"name\": \"score_answer\",\n",
    "            \"description\": \"Score a candidate's interview answer on Clarity, Correctness, and Completeness. Call this after every answer.\",\n",
    "            \"parameters\": schema\n",
    "        }\n",
    "    }\n",
    "\n",
    "SCORING_TOOL = build_tool_definition()\n",
    "\n",
    "# Handler for the score_answer tool\n",
    "def handle_score_answer(arguments: dict) -> AnswerScore:\n",
    "    \"\"\"Parse and validate the model's scoring output.\"\"\"\n",
    "    try:\n",
    "        score = AnswerScore(**arguments)\n",
    "        return score\n",
    "    except ValidationError as e:\n",
    "        # If the model generated invalid output, raise clearly\n",
    "        raise ValueError(f\"Model returned invalid scoring JSON: {e}\")\n",
    "\n",
    "# Tool Arbiter - routes tool calls to the right handler\n",
    "def tool_arbiter(tool_name: str, arguments_json: str) -> str:\n",
    "    \"\"\"Dispatch a tool call and return a serialized result string.\"\"\"\n",
    "    arguments = json.loads(arguments_json)\n",
    "    \n",
    "    if tool_name == \"score_answer\":\n",
    "        result = handle_score_answer(arguments)\n",
    "        return result.model_dump_json()\n",
    "    else:\n",
    "        return json.dumps({\"error\": f\"Unknown tool: {tool_name}\"})\n",
    "\n",
    "# Verify the tool definition looks correct\n",
    "print(json.dumps(SCORING_TOOL[\"function\"][\"parameters\"][\"properties\"].keys(), default=list))\n",
    "print(\"Tool arbiter ready.\")"
   ]
  },
