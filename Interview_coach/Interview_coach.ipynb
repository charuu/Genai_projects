    "# PART 5 - Tokenisation-aware context manager\n",
    "# You learned the theory of tokenisation in Class 4 (Tokenisation) - BPE, token\n",
    "# boundaries, why token count matters. Here we implement it in Python using tiktoken.\n",
    "# NOTE: The tiktoken library and Python implementation below require Python foundations\n",
    "# from Module 2. We cover this properly in Class 15 (LLM SDKs). This is a preview -\n",
    "# the concepts map directly to what you learned in Class 4.\n",
    "\n",
    "MODEL_NAME = \"gpt-4o-mini\"\n",
    "CONTEXT_LIMIT = 8000    # tokens - leave room below gpt-4o-mini's 128k for safety in this demo\n",
    "COMPLETION_RESERVE = 1000  # tokens reserved for the model's response\n",
    "MAX_HISTORY_TOKENS = CONTEXT_LIMIT - COMPLETION_RESERVE\n",
    "\n",
    "def count_tokens(messages: list[dict]) -> int:\n",
    "    \"\"\"Count tokens in a message list using tiktoken.\"\"\"\n",
    "    try:\n",
    "        enc = tiktoken.encoding_for_model(MODEL_NAME)\n",
    "    except KeyError:\n",
    "        enc = tiktoken.get_encoding(\"cl100k_base\")\n",
    "    \n",
    "    total = 0\n",
    "    for msg in messages:\n",
    "        total += 4  # per-message overhead\n",
    "        for key, value in msg.items():\n",
    "            if isinstance(value, str):\n",
    "                total += len(enc.encode(value))\n",
    "            elif isinstance(value, list):  # tool_calls field can be a list\n",
    "                total += len(enc.encode(str(value)))\n",
    "    total += 2  # reply primer\n",
    "    return total\n",
    "\n",
    "def trim_messages(messages: list[dict], max_tokens: int) -> list[dict]:\n",
    "    \"\"\"Remove oldest non-system messages until token count fits.\"\"\"\n",
    "    if count_tokens(messages) <= max_tokens:\n",
    "        return messages\n",
    "    \n",
    "    # Always keep: system prompt (index 0) + last 2 messages\n",
    "    system_msg = messages[0]\n",
    "    tail = messages[-2:] if len(messages) >= 2 else messages[-1:]\n",
    "    middle = messages[1:-2] if len(messages) > 3 else []\n",
    "    \n",
    "    # Drop from the front of middle until we fit\n",
    "    while middle and count_tokens([system_msg] + middle + tail) > max_tokens:\n",
    "        dropped = middle.pop(0)\n",
    "        print(f\"[Context trim] Dropped message: {dropped['role']} ({len(dropped.get('content', '')[:40])}...)\")\n",
    "    \n",
    "    return [system_msg] + middle + tail\n",
    "\n",
    "# Quick test\n",
    "test_msgs = [\n",
    "    {\"role\": \"system\", \"content\": INTERVIEW_SYSTEM_PROMPT},\n",
    "    {\"role\": \"user\", \"content\": \"Hello\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"Ready to begin. First question: Tell me about yourself.\"},\n",
    "]\n",
    "token_count = count_tokens(test_msgs)\n",
    "print(f\"Token count for 3-message history: {token_count}\")\n",
    "print(f\"Max history budget: {MAX_HISTORY_TOKENS} tokens\")"
   ]
  },
