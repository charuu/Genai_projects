    "# PART 7 - Complete Interaction Loop\n",
    "# NOTE: This class uses Python OOP (class, __init__, methods), type hints\n",
    "# (list[dict], list[AnswerScore]), and chained API calls - all covered in Module 2.\n",
    "# We cover Python classes and OOP in Class 14, type hints in Class 13, and\n",
    "# multi-turn API call patterns in Class 15. This is a preview - read the class as a\n",
    "# blueprint showing how all six components wire together. You will build and run this\n",
    "# fully in Class 20 (Module 2 capstone).\n",
    "\n",
    "class InterviewSession:\n",
    "    def __init__(self, role: str = \"Software Engineer\"):\n",
    "        self.role = role\n",
    "        self.messages = [\n",
    "            {\"role\": \"system\", \"content\": INTERVIEW_SYSTEM_PROMPT}\n",
    "        ]\n",
    "        self.question_count = 0\n",
    "        self.max_questions = 3\n",
    "        self.scores: list[AnswerScore] = []\n",
    "        self.interview_active = True\n",
    "        self.total_tokens_used = 0\n",
    "\n",
    "    def _call_api(self, include_tools: bool = True) -> dict:\n",
    "        \"\"\"Single API call with optional tool definitions.\"\"\"\n",
    "        trimmed = trim_messages(self.messages, MAX_HISTORY_TOKENS)\n",
    "        \n",
    "        kwargs = {\n",
    "            \"model\": MODEL_NAME,\n",
    "            \"messages\": trimmed,\n",
    "            \"temperature\": 0.3,\n",
    "        }\n",
    "        if include_tools:\n",
    "            kwargs[\"tools\"] = [SCORING_TOOL]\n",
    "            kwargs[\"tool_choice\"] = \"auto\"\n",
    "        \n",
    "        response = client.chat.completions.create(**kwargs)\n",
    "        \n",
    "        # Track token usage\n",
    "        usage = response.usage\n",
    "        self.total_tokens_used += usage.total_tokens\n",
    "        print(f\"[Tokens] This call: {usage.total_tokens} | Session total: {self.total_tokens_used}\")\n",
    "        \n",
    "        return response\n",
    "\n",
    "    def _handle_tool_calls(self, response) -> str:\n",
    "        \"\"\"Execute any tool calls and get the final reply.\"\"\"\n",
    "        message = response.choices[0].message\n",
    "        \n",
    "        if not message.tool_calls:\n",
    "            return message.content\n",
    "        \n",
    "        # Append the assistant's tool call request to history\n",
    "        self.messages.append(message.model_dump(exclude_none=True))\n",
    "        \n",
    "        # Process each tool call\n",
    "        for tool_call in message.tool_calls:\n",
    "            tool_name = tool_call.function.name\n",
    "            tool_args = tool_call.function.arguments\n",
    "            \n",
    "            print(f\"[Tool] Calling: {tool_name}\")\n",
    "            result_str = tool_arbiter(tool_name, tool_args)\n",
    "            \n",
    "            # Store parsed score if it's the scoring tool\n",
    "            if tool_name == \"score_answer\":\n",
    "                score_data = json.loads(result_str)\n",
    "                self.scores.append(AnswerScore(**score_data))\n",
    "            \n",
    "            # Append tool result to history\n",
    "            self.messages.append({\n",
    "                \"role\": \"tool\",\n",
    "                \"tool_call_id\": tool_call.id,\n",
    "                \"content\": result_str\n",
    "            })\n",
    "        \n",
    "        # Get the model's final reply after seeing the tool results\n",
    "        follow_up = self._call_api(include_tools=False)\n",
    "        return follow_up.choices[0].message.content\n",
    "\n",
    "    def start(self) -> str:\n",
    "        \"\"\"Begin the interview - get the first question.\"\"\"\n",
    "        self.messages.append({\n",
    "            \"role\": \"user\",\n",
    "            \"content\": f\"I'm ready to be interviewed for a {self.role} role. Please begin.\"\n",
    "        })\n",
    "        response = self._call_api()\n",
    "        reply = response.choices[0].message.content\n",
    "        self.messages.append({\"role\": \"assistant\", \"content\": reply})\n",
    "        self.question_count += 1\n",
    "        return reply\n",
    "\n",
    "    def answer(self, candidate_answer: str) -> str:\n",
    "        \"\"\"Submit an answer, get evaluation + next question (or end session).\"\"\"\n",
    "        if not self.interview_active:\n",
    "            return \"The interview session has ended. Call get_summary() for results.\"\n",
    "        \n",
    "        # Safety check first\n",
    "        if not safety_check(candidate_answer):\n",
    "            return \"That input is not related to the interview. Please answer the current question.\"\n",
    "        \n",
    "        # Add candidate's answer to history\n",
    "        self.messages.append({\"role\": \"user\", \"content\": candidate_answer})\n",
    "        \n",
    "        # Get model response (may include tool call for scoring)\n",
    "        response = self._call_api()\n",
    "        reply = self._handle_tool_calls(response)\n",
    "        \n",
    "        self.messages.append({\"role\": \"assistant\", \"content\": reply})\n",
    "        \n",
    "        # Track question count\n",
    "        if self.question_count < self.max_questions:\n",
    "            self.question_count += 1\n",
    "        else:\n",
    "            self.interview_active = False\n",
    "        \n",
    "        return reply\n",
    "\n",
    "    def get_summary(self) -> dict:\n",
    "        \"\"\"Compute session summary from stored scores.\"\"\"\n",
    "        if not self.scores:\n",
    "            return {\"error\": \"No scores recorded yet.\"}\n",
    "        \n",
    "        avg_clarity = sum(s.clarity for s in self.scores) / len(self.scores)\n",
    "        avg_correctness = sum(s.correctness for s in self.scores) / len(self.scores)\n",
    "        avg_completeness = sum(s.completeness for s in self.scores) / len(self.scores)\n",
    "        questions_passed = sum(1 for s in self.scores if s.pass_threshold)\n",
    "        overall_pass = questions_passed >= 2\n",
    "        \n",
    "        return {\n",
    "            \"questions_asked\": len(self.scores),\n",
